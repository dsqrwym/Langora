/**
 * Build-time manifest generator for the login backdrop.
 *
 * The login page is statically prerendered, so the photo directory must be
 * flattened into a TS constant at build time; there is no filesystem to read
 * at runtime on the edge. Runs on plain Node (>=23.6 strips types natively).
 *
 * The .mts extension declares ESM explicitly: without "type":"module" in
 * package.json, a .ts file is parsed as CJS first and re-parsed as ESM,
 * emitting MODULE_TYPELESS_PACKAGE_JSON on every run.
 */
import {existsSync, readdirSync, writeFileSync} from "node:fs";
import {dirname, join, resolve} from "node:path";
import {fileURLToPath} from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");

const PHOTO_DIR = join(ROOT, "public", "login", "photos");
const DEFAULT_PHOTO_FILE = join(ROOT, "public", "login", "default-photo.webp");
const OUTPUT_FILE = join(ROOT, "src", "features", "auth", "login-photos-generated.ts");

const EXTENSIONS = [".webp", ".avif", ".jpg", ".jpeg", ".png"];

type PhotoEntry = {
    id: string;
    src: string;
};

const toEntry = (name: string): PhotoEntry => {
    const dot = name.lastIndexOf(".");
    return {
        /* file name without extensions is the i18n key */
        id: dot > 0 ? name.slice(0, dot) : name,
        src: `/login/photos/${encodeURIComponent(name)}`,
    };
};

const scan = (): PhotoEntry[] => {
    if (!existsSync(PHOTO_DIR)) return [];

    return readdirSync(PHOTO_DIR, {withFileTypes: true})
        .filter((entry) => entry.isFile() && !entry.name.startsWith("."))
        .map((entry) => entry.name)
        .filter((name) => EXTENSIONS.some((extension) => name.toLowerCase().endsWith(extension)))
        .sort((a, b) => a.localeCompare(b))
        .map(toEntry);
};

const entries = scan();

const list: PhotoEntry[] = entries.length > 0
    ? entries
    : [{id: "default", src: "/login/default-photo.webp"}];

writeFileSync(
    OUTPUT_FILE,
    `// Generated by scripts/generate-login-photos.mts automatically, do not edit manually.
// Add photos: put them into public/login/photos/ and execute pnpm photos

export type LoginPhoto = {
    /** file name without extensions is the i18n key */
    id: string;
    /** site absolute path from public */
    src: string;
};

export const LOGIN_PHOTOS: readonly LoginPhoto[] = ${JSON.stringify(list, null, 4)};
`,
    "utf8",
);

if (entries.length === 0) {
    console.log("[login-photos] do not have custom photos, using default-photo.webp");
    if (!existsSync(DEFAULT_PHOTO_FILE)) {
        console.error("[login-photos] warning: public/login/default-photo.webp also does not exist");
    }
} else {
    console.log(`[login-photos] found ${entries.length} photos: ${entries.map((entry) => entry.id).join(", ")}`);
}
